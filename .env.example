# BookPro Environment Configuration Baseline
# DO NOT COMMIT REAL SECRETS TO THIS FILE

# System & Runtime
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
WORKER_PORT=4001
WEB_PORT=3000

# Client App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Database Connectivity (PostgreSQL 16)
DATABASE_URL="postgresql://bookpro_user:bookpro_pass@localhost:5432/bookpro_dev?schema=public&sslmode=disable"
DIRECT_URL="postgresql://bookpro_user:bookpro_pass@localhost:5432/bookpro_dev?schema=public&sslmode=disable"

# Redis Cache & Queue Transport (Redis 7)
REDIS_URL="redis://localhost:6379"

# Security & Tokens (Dev placeholders — MUST be overridden in production)
JWT_SECRET=dev_jwt_secret_min_32_chars_long_for_security_baseline_testing
JWT_EXPIRES_IN=7d
SESSION_EXPIRES_IN=30d
COOKIE_SECRET=dev_cookie_secret_min_32_chars_long
OAUTH_STATE_SECRET=dev_oauth_state_secret_min_32_chars_independent
QR_SIGNING_SECRET=dev_qr_signing_secret_min_32_chars_independent

# Observability
LOG_LEVEL=debug
LOG_FORMAT=json

# Phase P8 — Google Calendar & Token Encryption Configuration
API_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/google-calendar

# Phase P10 — Gemini AI Receptionist (server-side only)
# Free-tier availability and quotas are controlled by Google AI Studio and are not a production SLA.
AI_ENABLED=false
AI_VOICE_ENABLED=false
GEMINI_API_KEY=your-server-side-google-ai-studio-key
GEMINI_MODEL=gemini-3.7-flash
# Optional; falls back to JWT_SECRET. Use a dedicated 32+ character secret in production.
AI_PROPOSAL_SECRET=dev_ai_proposal_secret_min_32_chars_long
AI_RETENTION_DAYS=30
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_TOOL_DEPTH=4
AI_REQUESTS_PER_MINUTE=20
AI_MONTHLY_MESSAGE_LIMIT=1000
AI_PROVIDER_TIMEOUT_MS=15000

# Transactional email (server-side only — Brevo or disabled)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=BookPro <no-reply@your-verified-domain.com>

# Transactional SMS (server-side only — twilio or disabled)
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567


# Stripe Payment Gateway Configuration
# Mode must be explicitly set to 'disabled', 'test', or 'live'. Never inferred from missing keys.
STRIPE_MODE=disabled
# Required when STRIPE_MODE=test (sk_test_...) or STRIPE_MODE=live (sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Required when STRIPE_MODE=test or live (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Optional Stripe Connect platform OAuth Client ID (ca_...)
STRIPE_CLIENT_ID=ca_your_stripe_client_id
# Optional frontend publishable key (pk_test_... or pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
