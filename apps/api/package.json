{
    "name": "@bookpro/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "ts-node src/main.ts",
        "start:prod": "node dist/main",
        "lint": "eslint \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:integration": "jest --config test/jest-integration.json"
    },
    "dependencies": {
        "@bookpro/config": "workspace:*",
        "@bookpro/contracts": "workspace:*",
        "@bookpro/observability": "workspace:*",
        "@bookpro/server-core": "workspace:*",
        "@bookpro/validation": "workspace:*",
        "@bookpro/worker": "workspace:*",
        "@nestjs/bullmq": "^11.0.5",
        "@nestjs/common": "^10.3.3",
        "@nestjs/core": "^10.3.3",
        "@nestjs/platform-express": "^10.3.3",
        "@nestjs/swagger": "^7.4.2",
        "@nestjs/terminus": "^10.2.0",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/client": "^5.11.0",
        "@types/ioredis": "^5.0.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.1.5",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "reflect-metadata": "^0.2.1",
        "rxjs": "^7.8.1",
        "stripe": "^22.5.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@bookpro/eslint-config": "workspace:*",
        "@bookpro/test-utils": "workspace:*",
        "@bookpro/tsconfig": "workspace:*",
        "@nestjs/cli": "^10.3.2",
        "@nestjs/schematics": "^10.1.1",
        "@nestjs/testing": "^10.3.3",
        "@types/bcryptjs": "^3.0.0",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.11.24",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^9.0.8",
        "jest": "^29.7.0",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    }
}