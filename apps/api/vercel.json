{
    "version": 2,
    "framework": null,
    "buildCommand": "cd ../.. && pnpm run db:generate && pnpm turbo run build --filter=@bookpro/api...",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "dist/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "crons": [
        {
            "path": "/api/v1/cron/worker",
            "schedule": "0 0 * * *"
        }
    ]
}
