  paymentStatus         String            @default("UNPAID") // NOT_REQUIRED | UNPAID | PARTIALLY_PAID | PAID | PARTIALLY_REFUNDED | REFUNDED | FAILED
  bookingSource         String            @default("CUSTOMER_WEB") // CUSTOMER_WEB | STAFF_MANUAL | RECURRING_SERIES | AI | WAITLIST
  version               Int               @default(1)
  cancelReason          String?
  cancelledAt           DateTime?         @db.Timestamptz(6)
  cancelledById         String?           @db.Uuid
  checkInAt             DateTime?         @db.Timestamptz(6)
  priceCents            Int
  currency              String            @default("USD")
  internalNotes         String?
  overrideReason        String?
  metadata              Json?
  recoveredRevenueCents Int?              @map("recovered_revenue_cents")
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location               Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service                Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff                  StaffProfile?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recurrenceSeries       RecurrenceSeries?       @relation(fields: [recurrenceSeriesId], references: [id], onDelete: SetNull)
  bookingHold            BookingHold?            @relation(fields: [bookingHoldId], references: [id], onDelete: SetNull)
  resources              AppointmentResource[]
  history                AppointmentHistory[]
  intakeResponses        IntakeResponse[]
  paymentRecords         PaymentRecord[]
  commissionRecords      CommissionRecord[]
  cancellationQuotes     CancellationQuote[]
  financialLedgerEntries FinancialLedgerEntry[]
  notifications          Notification[]
  externalEvents         ExternalCalendarEvent[]
  calendarSyncConflicts  CalendarSyncConflict[]
  waitlistOffers         WaitlistOffer[]
  review                 Review?

  @@index([organizationId])
  @@index([locationId])
  @@index([staffId])
  @@index([customerId])
  @@index([startAt, endAt])
  @@index([organizationId, customerId, bookingDate])
  @@index([status])
  @@map("appointments")
}

