// BookPro Canonical Prisma Schema Baseline
// Source Specification: docs/DATABASE.md & ARCHITECTURE.md §127-136

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleCode {
  OWNER
  ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccountType {
  ORGANIZATION
  CUSTOMER
}

enum EmailCampaignStatus {
  DRAFT
  QUEUED
  SENT
}

enum EntitlementStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  HOLD
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistEntryStatus {
  ACTIVE
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

enum WaitlistOfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  LOST_TO_ANOTHER_CUSTOMER
}

enum TimeOfDayPreference {
  ANY
  MORNING
  AFTERNOON
  EVENING
}

enum AIConversationChannel {
  TEXT
  VOICE
}

enum AIConversationStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum AIToolExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
  PROPOSED
}

enum AIActionProposalStatus {
  PENDING
  CONFIRMED
  EXECUTED
  EXPIRED
  REJECTED
}

enum ScheduleInsightStatus {
  ACTIVE
  STALE
  ACTIONED
  DISMISSED
}

enum ReviewStatus {
  PUBLISHED
  PENDING_MODERATION
  HIDDEN
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_DEPARTURE
  CORRECTED
}

enum ExportType {
  CUSTOMERS
  APPOINTMENTS
  PAYMENTS
  REVENUE_REPORT
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  slug                String    @unique
  timezone            String    @default("UTC")
  isActive            Boolean   @default(true)
  industry            String?
  currency            String    @default("USD")
  defaultLocale       String    @default("en-US")
  supportedLocales    Json?
  country             String    @default("US")
  phone               String?
  email               String?
  website             String?
  bookingEnabled      Boolean   @default(false)
  brandName           String?
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String?
  accentColor         String?
  onboardingStep      Int       @default(1)
  onboardingCompleted Boolean   @default(false)
  stripeAccountId     String?   @unique @map("stripe_account_id")
  stripeConnectedAt   DateTime? @map("stripe_connected_at") @db.Timestamptz(6)
  stripeChargesEnabled Boolean  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean  @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted Boolean @default(false) @map("stripe_details_submitted")
  paymentIntent       String?   @map("payment_intent")
  archivedAt          DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  autoOfferEnabled    Boolean @default(false) @map("auto_offer_enabled")
  noShowSignalEnabled Boolean @default(false) @map("no_show_signal_enabled")
  optimizerMinGapMin  Int     @default(30) @map("optimizer_min_gap_min")

  locations                 Location[]
  memberships               Membership[]
  services                  Service[]
  customers                 Customer[]
  invitations               Invitation[]
  customerInvitations       CustomerInvitation[]
  emailTemplates            OrganizationEmailTemplate[]
  emailCampaigns            EmailCampaign[]
  entitlements              Entitlement[]
  featureOverrides          FeatureOverride[]
  auditLogs                 AuditLog[]
  staffProfiles             StaffProfile[]
  staffAvailabilities       StaffAvailability[]
  staffBreaks               StaffBreak[]
  staffLeaves               StaffLeave[]
  locationHolidays          LocationHoliday[]
  scheduleBlocks            ScheduleBlock[]
  resourcePools             ResourcePool[]
  resources                 Resource[]
  intakeForms               IntakeForm[]
  policyConfigs             PolicyConfig[]
  storedAssets              StoredAsset[]
  scheduleGuards            ScheduleGuard[]
  bookingHolds              BookingHold[]
  appointments              Appointment[]
  recurrenceSeries          RecurrenceSeries[]
  idempotencyRecords        IdempotencyRecord[]
  paymentRecords            PaymentRecord[]
  refundRecords             RefundRecord[]
  coupons                   Coupon[]
  commissionRules           CommissionRule[]
  commissionRecords         CommissionRecord[]
  reconciliationIncidents   ReconciliationIncident[]
  cancellationQuotes        CancellationQuote[]
  financialLedgerEntries    FinancialLedgerEntry[]
  notifications             Notification[]
  outboxEvents              OutboxEvent[]
  emailVerificationTokens   EmailVerificationToken[]
  registrationRequests      RegistrationRequest[]
  googleCalendarConnections GoogleCalendarConnection[]
  externalCalendarEvents    ExternalCalendarEvent[]
  calendarSyncConflicts     CalendarSyncConflict[]
  waitlistEntries           WaitlistEntry[]
  waitlistOffers            WaitlistOffer[]
  aiConversations           AIConversation[]
  aiToolExecutions          AIToolExecution[]
  aiActionProposals         AIActionProposal[]
  scheduleInsights          ScheduleInsight[]
  orgDailyMetrics           OrgDailyMetric[]
  locationDailyMetrics      LocationDailyMetric[]
  staffDailyMetrics         StaffDailyMetric[]
  serviceDailyMetrics       ServiceDailyMetric[]
  waitlistDailyMetrics      WaitlistDailyMetric[]
  reviews                   Review[]
  staffAttendances          StaffAttendance[]
  dataExports               DataExport[]
  productAnalyticsEvents    ProductAnalyticsEvent[]
  stripeOAuthStates         StripeOAuthState[]

  @@index([slug])
  @@map("organizations")
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  timezone       String    @default("UTC")
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String    @default("US")
  phone          String?
  email          String?
  operatingHours Json?
  instructions   String?
  parkingAccess  String?
  taxRatePct     Decimal?  @db.Decimal(5, 2)
  archivedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffLocations       StaffLocation[]
  staffAvailabilities  StaffAvailability[]
  locationHolidays     LocationHoliday[]
  scheduleBlocks       ScheduleBlock[]
  resources            Resource[]
  policyConfigs        PolicyConfig[]
  bookingHolds         BookingHold[]
  appointments         Appointment[]
  recurrenceSeries     RecurrenceSeries[]
  waitlistEntries      WaitlistEntry[]
  waitlistOffers       WaitlistOffer[]
  scheduleInsights     ScheduleInsight[]
  locationDailyMetrics LocationDailyMetric[]
  reviews              Review[]
  staffAttendances     StaffAttendance[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("locations")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  fullName        String
  phone           String?
  isPlatformAdmin Boolean   @default(false)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  accountType     AccountType @default(ORGANIZATION) @map("account_type")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  memberships             Membership[]
  customers               Customer[]
  emailVerificationTokens EmailVerificationToken[]
  registrationRequests    RegistrationRequest[]
  customerInvitations     CustomerInvitation[] @relation("AcceptedCustomerInvitation")
  authSessions            AuthSession[]
  mfaCredential           MfaCredential?
  mfaChallenges           MfaChallenge[]

  @@index([email])
  @@map("users")
}

model EmailVerificationToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model RegistrationRequest {
  id                 String   @id @default(uuid()) @db.Uuid
  idempotencyKey     String   @unique @map("idempotency_key")
  requestFingerprint String   @map("request_fingerprint")
  userId             String   @unique @map("user_id") @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  completedAt        DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("registration_requests")
}

model Role {
  code           RoleCode @id
  name           String
  description    String?
  isPlatformRole Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  roleCode      RoleCode
  permissionKey String

  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@unique([roleCode, permissionKey])
  @@index([roleCode])
  @@map("role_permissions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleCode       RoleCode         @default(STAFF)
  status         MembershipStatus @default(ACTIVE)
  locationIds    Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  roleCode       RoleCode         @default(STAFF)
  locationIds    Json?
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @db.Timestamptz(6)
  createdBy      String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@map("invitations")
}

model CustomerInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @db.Timestamptz(6)
  createdBy      String?          @db.Uuid
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("AcceptedCustomerInvitation", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, email, status])
  @@index([email])
  @@map("customer_invitations")
}

model OrganizationEmailTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  subject        String
  htmlBody       String   @map("html_body")
  textBody       String?  @map("text_body")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    EmailCampaign[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("organization_email_templates")
}

model EmailCampaign {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  templateId     String              @map("template_id") @db.Uuid
  name           String
  status         EmailCampaignStatus @default(DRAFT)
  recipientCount Int                 @default(0) @map("recipient_count")
  deliveredCount Int                 @default(0) @map("delivered_count")
  failedCount    Int                 @default(0) @map("failed_count")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdBy      String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     OrganizationEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([organizationId, createdAt])
  @@map("email_campaigns")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  deviceName       String    @map("device_name")
  authLevel        String    @default("pwd") @map("auth_level")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
}

model MfaCredential {
  userId          String   @id @map("user_id") @db.Uuid
  secretEncrypted String   @map("secret_encrypted")
  enabledAt       DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)
  lastUsedStep    BigInt?  @map("last_used_step")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  credential MfaCredential @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  purpose        String
  pendingSecret  String?   @map("pending_secret")
  organizationId String?   @map("organization_id") @db.Uuid
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model AuthRateLimit {
  key          String    @id
  attempts     Int       @default(0)
  windowEnd    DateTime  @map("window_end") @db.Timestamptz(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([windowEnd])
  @@map("auth_rate_limits")
}

model Plan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  maxLocations       Int      @default(1)
  maxStaff           Int      @default(5)
  maxMonthlyBookings Int      @default(500)
  features           Json?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  entitlements Entitlement[]

  @@map("plans")
}

model Entitlement {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  planId             String            @db.Uuid
  status             EntitlementStatus @default(ACTIVE)
  currentPeriodStart DateTime          @default(now()) @db.Timestamptz(6)
  currentPeriodEnd   DateTime          @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("entitlements")
}

model FeatureOverride {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  featureKey     String
  enabled        Boolean  @default(true)
  limitOverride  Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey])
  @@index([organizationId])
  @@map("feature_overrides")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorType      String
  actorId        String
  action         String
  resourceType   String
  resourceId     String
  payload        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Service {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @db.Uuid
  name                    String
  description             String?
  category                String?
  imageUrl                String?
  durationMin             Int
  preBufferMin            Int       @default(0)
  postBufferMin           Int       @default(0)
  priceCents              Int
  currency                String    @default("USD")
  depositType             String?   @default("NONE")
  depositValue            Int?      @default(0)
  taxBehavior             String    @default("EXCLUSIVE")
  capacity                Int       @default(1)
  minParticipants         Int       @default(1)
  maxParticipants         Int       @default(1)
  version                 Int       @default(1)
  preparationInstructions String?
  isActive                Boolean   @default(true)
  archivedAt              DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffServices       StaffService[]
  serviceResources    ServiceResource[]
  serviceIntakeForms  ServiceIntakeForm[]
  policyConfigs       PolicyConfig[]
  bookingHolds        BookingHold[]
  appointments        Appointment[]
  recurrenceSeries    RecurrenceSeries[]
  waitlistEntries     WaitlistEntry[]
  waitlistOffers      WaitlistOffer[]
  scheduleInsights    ScheduleInsight[]
  serviceDailyMetrics ServiceDailyMetric[]
  reviews             Review[]

  @@index([organizationId])
  @@map("services")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  fullName       String
  email          String
  phone          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization               Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  tags                       String[]           @default([])
  operationalNotes           String?
  totalSpentCents            Int                @default(0)
  completedAppointmentsCount Int                @default(0)
  cancelledCount             Int                @default(0)
  noShowCount                Int                @default(0)
  lastBookingAt              DateTime?          @db.Timestamptz(6)
  nextBookingAt              DateTime?          @db.Timestamptz(6)
  consentMarketing           Boolean            @default(false)
  consentMarketingAt         DateTime?          @db.Timestamptz(6)
  consentSource              String?
  notes                      CustomerNote[]
  bookingHolds               BookingHold[]
  appointments               Appointment[]
  recurrenceSeries           RecurrenceSeries[]
  notifications              Notification[]
  waitlistEntries            WaitlistEntry[]
  reviews                    Review[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([userId])
  @@map("customers")
}

model OutboxEvent {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String?   @db.Uuid
  aggregateType     String
  aggregateId       String
  eventType         String
  eventVersion      Int       @default(1)
  payload           Json
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  lastError         String?
  workerId          String?   @map("worker_id")
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  completedHandlers String[]  @default([]) @map("completed_handlers")
  deadLetteredAt    DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  availableAt       DateTime  @default(now()) @db.Timestamptz(6)
  processedAt       DateTime? @db.Timestamptz(6)
  publishedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, leaseExpiresAt])
  @@index([status, availableAt, createdAt])
  @@index([organizationId])
  @@map("outbox_events")
}

model StaffProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  membershipId       String    @unique @db.Uuid
  displayName        String
  title              String?
  bio                String?
  avatarUrl          String?
  skills             Json?
