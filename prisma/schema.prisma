  candidateMatches      Json                  @default("[]") @map("candidate_matches")
  aiExplanation         String?               @map("ai_explanation")
  status                ScheduleInsightStatus @default(ACTIVE)
  dedupKey              String                @map("dedup_key")
  actionedAt            DateTime?             @map("actioned_at") @db.Timestamptz(6)
  actionedOfferId       String?               @map("actioned_offer_id") @db.Uuid
  dismissedAt           DateTime?             @map("dismissed_at") @db.Timestamptz(6)
  dismissedBy           String?               @map("dismissed_by")
  staleAt               DateTime?             @map("stale_at") @db.Timestamptz(6)
  metadata              Json?
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff        StaffProfile?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service      Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  offers       WaitlistOffer[]

  @@unique([organizationId, dedupKey, status])
  @@index([organizationId, status, startAt])
  @@index([locationId, staffId])
  @@map("schedule_insights")
}

